# ============================================================
# Web (Vercel): variables de build. Se incrustan al compilar,
# así que cambiarlas exige volver a desplegar.
# ============================================================
VITE_API_BASE_URL=https://pet-pulse-api.onrender.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_PUBLISHABLE_KEY

# ============================================================
# API (Render): variables de entorno del servicio.
# ============================================================
NODE_ENV=production
CLERK_AUTH_MODE=external
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_SECRET_KEY
ALLOWED_WEB_ORIGINS=https://REPLACE_WITH_VERCEL_DOMAIN
PETPULSE_ADMIN_EMAILS=admin@example.com

# Supabase: usar la cadena del "Session pooler" (puerto 5432).
DATABASE_URL=postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Opcional, recomendado en producción: certificado de la CA de Supabase.
# Pegar el PEM con los saltos de línea escapados como \n.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\nMIIB...\n-----END CERTIFICATE-----
DATABASE_POOL_MAX=5

# ============================================================
# Storage privado de fotos de mascotas (Supabase Storage).
# Crear el bucket privado pet-photos en cada proyecto Supabase.
# ============================================================
SUPABASE_URL=https://REPLACE_WITH_SUPABASE_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PET_PHOTOS_BUCKET=pet-photos
